          { step: 3, action: "POST /api/phone/send-sms — SMS teaser to VIP list", type: "agentos" },
          { step: 4, action: "POST /api/analytics/track — track open rates", type: "agentos" }
        ],
        difficulty: "beginner",
        time_to_implement: "15 minutes"
      }
