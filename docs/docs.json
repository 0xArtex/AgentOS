{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Palmyr",
  "colors": {
    "primary": "#F6AF56",
    "light": "#F8C68A",
    "dark": "#E0913A"
  },
  "fonts": {
    "heading": { "family": "Cormorant Garamond", "weight": 600 },
    "body": { "family": "DM Sans" }
  },
  "appearance": {
    "default": "dark"
  },
  "background": {
    "color": {
      "light": "#ffffff",
      "dark": "#112d32"
    }
  },
  "favicon": "/favicon.svg",
  "seo": {
    "metatags": {
      "og:image": "https://docs.palmyr.ai/images/og.png",
      "og:image:width": "1200",
      "og:image:height": "630",
      "twitter:image": "https://docs.palmyr.ai/images/og.png",
      "twitter:card": "summary_large_image"
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": ["introduction", "quickstart", "for-agents"]
          },
          {
            "group": "Services",
            "pages": [
              "pricing",
              "services/trading",
              "services/phone",
              "services/email",
              "services/compute",
              "services/domains",
              "services/card",
              "services/twitter",
              "services/tiktok",
              "services/marketplace"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/how-palmyr-works",
              "concepts/payments",
              "concepts/wallets"
            ]
          },
          {
            "group": "Security & Trust",
            "pages": [
              "security/model",
              "security/permissions",
              "security/privacy"
            ]
          }
        ]
      },
      {
        "tab": "Reference",
        "groups": [
          {
            "group": "Reference",
            "pages": ["reference/cli", "reference/api"]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "skill.md",
          "href": "https://palmyr.ai/skill.md",
          "icon": "robot"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/0xArtex/Palmyr",
          "icon": "github"
        },
        {
          "anchor": "palmyr.ai",
          "href": "https://palmyr.ai",
          "icon": "globe"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/0xArtex/Palmyr"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get the CLI",
      "href": "https://www.npmjs.com/package/@palmyr/cli"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/0xArtex/Palmyr",
      "website": "https://palmyr.ai"
    }
  }
}
