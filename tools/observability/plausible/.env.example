# Copy to .env and fill in. .env is gitignored — never commit secrets.

# Generate with:  openssl rand -base64 48
SECRET_KEY_BASE=REPLACE_ME_WITH_48_BYTES_BASE64

# Public URL visitors hit. Must match where Plausible is reached from the
# outside (Cloudflare Tunnel hostname). The tracking snippet in public/*.html
# references this same hostname.
BASE_URL=https://plausible.palmyr.ai

# After the first admin registers, lock down so randoms can't sign up.
# Options: `false` | `true` (fully locked) | `invite_only` (admin invites only)
DISABLE_REGISTRATION=invite_only

# Internal-only — leave as defaults unless you know what you're doing.
DATABASE_URL=postgres://postgres:postgres@plausible_db:5432/plausible_db
CLICKHOUSE_DATABASE_URL=http://plausible_events_db:8123/plausible_events_db
