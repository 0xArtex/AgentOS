<clickhouse>
    <profiles>
        <default>
            <log_queries>0</log_queries>
            <log_query_threads>0</log_query_threads>
        </default>
    </profiles>
    <!-- ClickHouse 24.3+ requires explicit auth config for the `default` user.
         Plausible connects as `default` with no password — declare that
         explicitly via <no_password/>, or the connector hits AUTHENTICATION_FAILED.

         replace="replace" forces this overlay to FULLY replace the base
         users.xml entry. Without it ClickHouse merges, ending up with both
         <password> and <no_password> on the same user, which is a fatal
         "must be only one auth field" config error. -->
    <users>
        <default replace="replace">
            <profile>default</profile>
            <quota>default</quota>
            <networks>
                <ip>::/0</ip>
            </networks>
            <no_password/>
            <access_management>0</access_management>
        </default>
    </users>
</clickhouse>
