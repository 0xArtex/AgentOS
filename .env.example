# Server Configuration
PORT=3000
NODE_ENV=development

# Solana / x402 Payment Protocol
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
TREASURY_WALLET=YOUR_SOLANA_WALLET_ADDRESS
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# Twilio (Phone/SMS Service)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# SendGrid (Email Service)
SENDGRID_API_KEY=
EMAIL_FROM=noreply@agentos.dev

# SMTP (Alternative Email Service)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_DOMAIN=mail.agentos.dev

# Inbound Email Webhook
EMAIL_WEBHOOK_SECRET=

# Hetzner Cloud (Compute Service)
HCLOUD_TOKEN=

# Domain Registrar
DOMAIN_REGISTRAR=namecheap
# Namecheap API (if using Namecheap)
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_USERNAME=
# Cloudflare API (if using Cloudflare)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# API Key Providers (for provisioning to users)
BRAVE_SEARCH_API_KEY=
HELIUS_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# AgentOS Wallet Vault
AGENTOS_WALLET_PASSWORD=     # Password for encrypted vault (Scrypt + AES-256-GCM)
AGENTOS_WALLET_PATH=         # Custom vault path (default: ~/.agentos/wallet/)
AGENTWALLET_API=             # Optional: on-chain smart wallet deployment service

# Database
DATABASE_PATH=./data/agentos.db
