# Server Configuration
PORT=3000
NODE_ENV=development

# Solana / x402 Payment Protocol
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
TREASURY_WALLET=YOUR_SOLANA_WALLET_ADDRESS
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# x402 facilitator
# In production you must configure ONE of:
#   (a) Self-hosted: set X402_FACILITATOR_BEARER (server refuses to boot otherwise)
#   (b) Coinbase CDP: set CDP_API_KEY_ID + CDP_API_KEY_SECRET — when present,
#       EVM verify/settle routes through https://api.cdp.coinbase.com/platform/v2/x402
#       so paid endpoints become discoverable in the x402 Bazaar.
# Solana always uses the self-hosted path (server co-signs as fee-payer so
# users only need USDC, never SOL).
X402_FACILITATOR_BEARER=
X402_FACILITATOR_URL_INTERNAL=http://localhost:8090
X402_FACILITATOR_URL=https://agntos.dev/x402

# Coinbase CDP (https://portal.cdp.coinbase.com → API Keys). Required for
# Bazaar discoverability — without these, EVM payments still work via
# X402_FACILITATOR_BEARER but routes won't be indexed by the CDP Bazaar.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Master key for encrypting custodial deposit-wallet session secrets.
# 64 hex chars (32 bytes). MUST be set in production.
DEPOSIT_MASTER_KEY=

# CapSolver (https://capsolver.com) — solves TikTok captchas during form login.
# Required if you want agents to log in TikTok accounts using password auth.
# Without this, only cookie-injection logins work.
CAPSOLVER_API_KEY=

# Twilio (Phone/SMS Service)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email — Mailgun (https://www.mailgun.com)
# Sign up → 30-day Foundation trial unlocks 1,000 sending domains for $0,
# then $35/mo. No formal "production access" application like SES — just
# verify a domain via DNS and send. Settings → API Keys gives you both
# values below.
MAILGUN_API_KEY=
MAILGUN_REGION=us                    # us | eu (matches dashboard region)
MAILGUN_WEBHOOK_SIGNING_KEY=         # Settings → Webhooks → HTTP webhook signing key
EMAIL_DOMAIN=agntos.dev              # default sender domain for default-domain inboxes
EMAIL_FROM=noreply@agntos.dev

# Hetzner Cloud (Compute Service)
HCLOUD_TOKEN=

# Domain Registrar
DOMAIN_REGISTRAR=namecheap
# Namecheap API (if using Namecheap)
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_USERNAME=
# Cloudflare API (if using Cloudflare)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# API Key Providers (for provisioning to users)
BRAVE_SEARCH_API_KEY=
HELIUS_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
EXA_API_KEY=                 # For i402 web_search via Exa. Without this, the AgentOS fallback search is used.

# AgentOS Wallet Vault — non-custodial
# User wallets are encrypted with the owner's passphrase. The server never
# stores the passphrase. Agents authenticate via HKDF-derived API keys
# (agos_key_...) issued by the wallet owner.
AGENTOS_WALLET_PATH=         # Custom vault path (default: ~/.agentos/wallet/)

# Deposit wallets (server-internal, intentionally custodial)
# Used to receive USDC and auto-sweep to treasury. The server needs autopilot
# access, so deposit wallets use a server-held passphrase. Set to a strong
# random secret. Without this the server cannot create deposit wallets.
AGENTOS_DEPOSIT_PASSWORD=

AGENTWALLET_API=             # Optional: on-chain smart wallet deployment service

# Database
DATABASE_PATH=./data/agentos.db

# ─── i402 Protocol Orchestrator ─────────────────────────────────────────────
# Reference implementation of the i402 spec (see spec/i402.md).
# The orchestrator takes natural-language intents and returns a plan of x402
# calls that fulfill them. AGENTOS_API_BASE is what gets baked into registered
# provider endpoints when seedAgentOSPrimitives() runs.
AGENTOS_API_BASE=https://agntos.dev

# Anthropic model tiering. Haiku handles simple single-capability routing;
# Opus handles multi-step compound plans and ambiguous intents.
I402_MODEL_ROUTER=claude-haiku-4-5-20251001
I402_MODEL_PLANNER=claude-opus-4-7
I402_MAX_OUTPUT_TOKENS=4096

# Prompt caching is mandatory for the economic model to work. Cache TTL is
# 5 minutes per Anthropic's prompt cache. Keep this enabled in production.
I402_PROMPT_CACHE_ENABLED=true

# Orchestration fee taken on top of the sum of step costs. Covers LLM spend
# on planning + execution supervision. 0.15 == 15%.
I402_ORCHESTRATION_FEE_PCT=0.15

# Session lifecycle
I402_SESSION_IDLE_TIMEOUT_HOURS=24
I402_SESSION_MAX_BUDGET_USDC=500

# Agentic Market federation (Coinbase). Leave empty to disable AM provider
# ingestion; provider registry will only contain first-party + curated.
I402_AGENTIC_MARKET_CATALOG_URL=
I402_AGENTIC_MARKET_REFRESH_MINUTES=60

# Two-stage retrieval: narrow by embedding to top-N before LLM sees providers.
I402_RETRIEVAL_TOP_N=20
