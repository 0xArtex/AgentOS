+
+    // Hackathon countdown
+    const deadline = new Date('2026-02-12T17:00:00Z').getTime();
+    function updateCountdown() {
+      const now = Date.now();
+      const diff = deadline - now;
+      if (diff <= 0) {
+        document.getElementById('countdown').textContent = 'HACKATHON ENDED';
+        return;
+      }
+      const d = Math.floor(diff / 86400000);
+      const h = Math.floor((diff % 86400000) / 3600000);
+      const m = Math.floor((diff % 3600000) / 60000);
+      const s = Math.floor((diff % 60000) / 1000);
+      document.getElementById('countdown').textContent = 
+        `${d}d ${h.toString().padStart(2,'0')}h ${m.toString().padStart(2,'0')}m ${s.toString().padStart(2,'0')}s remaining`;
+    }
+    updateCountdown();
+    setInterval(updateCountdown, 1000);
+
+    // Activity feed
+    async function loadActivity() {
+      try {
+        const res = await fetch('/activity');
+        const data = await res.json();
+        const feed = document.getElementById('activity-feed');
+        if (!feed || !data.activity) return;
+        feed.innerHTML = data.activity.slice(0, 8).map(a => {
+          const time = new Date(a.timestamp).toLocaleTimeString();
+          const icon = a.type === 'registration' ? '🤖' : a.type === 'provision' ? '📦' : a.type === 'message' ? '💬' : '⚡';
+          return `<div style="padding: 0.6rem 1rem; background: var(--bg2); border: 1px solid var(--border); border-radius: 8px; display: flex; justify-content: space-between;"><span>${icon} ${a.description || a.type}</span><span style="color: var(--text-dim);">${time}</span></div>`;
+        }).join('');
+      } catch {}
+    }
+    loadActivity();
+    setInterval(loadActivity, 30000);
